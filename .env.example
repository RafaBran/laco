# Copie para .env e preencha localmente. NUNCA versione o .env.
# Todos os valores abaixo são placeholders.

# Ambiente
APP_ENV=development

# Banco de dados
DATABASE_URL=postgresql+psycopg://laco:CHANGE_ME@localhost:5432/laco

# Tokens próprios (assinatura assimétrica: RS256 ou EdDSA)
JWT_ALGORITHM=EdDSA
JWT_ISSUER=http://localhost:8000
JWT_AUDIENCE=laco-web
JWT_PRIVATE_KEY_PATH=./secrets/jwt_private.pem
JWT_PUBLIC_KEY_PATH=./secrets/jwt_public.pem
ACCESS_TOKEN_TTL_SECONDS=600
REFRESH_TOKEN_TTL_SECONDS=86400

# Nhoque (LLM) — chave só no servidor, nunca no navegador
LLM_API_KEY=CHANGE_ME
LLM_MODEL=CHANGE_ME

# Site
WEB_ORIGIN=http://localhost:5173
